# Copie para .env.local (ou rode `vercel env pull .env.local --yes`). Nunca commite valores reais.

# URL oficial do site, sem barra no final (canonical, sitemap, Open Graph). ACOES-PENDENTES T3
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager (ex.: GTM-KH4SD94D), carregado só após o aceite de cookies. O GA4 é
# configurado dentro do contêiner. Vazio = nada do Google e sem aviso de cookies. ACOES-PENDENTES T5
NEXT_PUBLIC_GTM_ID=

# Formulário de contato (Resend). ACOES-PENDENTES T4
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
